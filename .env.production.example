# Template for a deployed environment's .env file (prod or staging), on the
# VPS this app is self-hosted on.
#
# This file is NOT deployed automatically (git-ignored, so it stays
# untracked in the deploy checkout). Copy it to `.env` in the app checkout
# (`/home/anufaroot/deploy/minerva-<env>`) via `cp .env.production.example
# .env`, then fill in the real values below. See the Deployment section in
# README.md for the full one-time environment setup.

APP_NAME="Anufa Minerva"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://minerva.anufa.my.id

# Generate locally with: php artisan key:generate --show
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Creates the first admin login on the first `php artisan deploy:finalize` run
# (skipped afterwards). Change the password after first login.
ADMIN_NAME="Admin"
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=minerva_prod
DB_USERNAME=minerva_prod
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Drained by a persistent worker (systemd unit minerva-queue@<env>, see
# deploy/systemd/), not a cron poll — this is our own VPS, so a long-running
# `queue:work` process is fine.
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
