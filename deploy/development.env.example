# Copy to deploy/development.env and fill in the values (gitignored - do not commit).
# Run from inside the app checkout on the server, via cPanel terminal:
#
#   deploy/deploy.sh development deploy

# Absolute path to the app checkout on the server (git clone target).
APP_DIR=/home/cpaneluser/anufa-minerva-dev

# Absolute path to the subdomain's document root (kept separate from
# APP_DIR - set via cPanel > Domains).
DOCROOT_DIR=/home/cpaneluser/minerva-dev.anufa-technologies.my.id

GIT_BRANCH=develop

# Path to the activate script for the node/npm virtualenv created by cPanel's
# "Setup Node.js App" (Software section). Create an app there pointing its
# "Application root" at APP_DIR, then copy the path cPanel shows under
# "Enter to the virtual environment", e.g.:
#   source /home/cpaneluser/nodevenv/anufa-minerva-dev/20/bin/activate
# Leave empty if node/npm are already on PATH without it.
NODE_VENV_ACTIVATE=/home/cpaneluser/nodevenv/anufa-minerva-dev/20/bin/activate

# Absolute path to the composer binary, if `composer --version` doesn't
# already work in a fresh terminal. Install with:
#   cd ~ && curl -sS https://getcomposer.org/installer | php
#   mkdir -p ~/bin && mv composer.phar ~/bin/composer && chmod +x ~/bin/composer
# Leave empty to just run `composer` from PATH.
COMPOSER_BIN=/home/cpaneluser/bin/composer
