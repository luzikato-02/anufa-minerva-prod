# Instantiated systemd unit for Minerva's queue worker — one instance per
# environment (minerva-queue@prod, minerva-queue@dev), matching the
# minerva-<env> deploy directory and php-fpm pool naming convention.
#
# Install (one-time):
#   sudo cp deploy/systemd/minerva-queue@.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now minerva-queue@prod minerva-queue@dev
#
# deploy/deploy.sh restarts the matching instance after every deploy —
# queue:work keeps a single PHP process warm across jobs, so it never picks
# up new code on its own the way php-fpm does.
[Unit]
Description=Minerva queue worker (%i)
After=network.target postgresql.service

[Service]
Type=simple
User=anufaroot
WorkingDirectory=/home/anufaroot/deploy/minerva-%i
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
